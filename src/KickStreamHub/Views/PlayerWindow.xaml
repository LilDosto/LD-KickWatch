<Window x:Class="KickStreamHub.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="LD KickWatch — Canlı Yayın Oynatıcı" Height="720" Width="1140" MinWidth="480" MinHeight="340"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="PlayerWindow_KeyDown"
        Background="#04090F">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Control Bar (Collapsed in Fullscreen) -->
        <Border x:Name="TopBar" Grid.Row="0" Background="#0D141F" Padding="12,7" BorderBrush="#1C283B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Channel Title, Engine Switcher (Web vs VLC) and Quality Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#53FC18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ChannelTitleText" FontWeight="ExtraBold" FontSize="13.5" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <!-- Web Engine Button -->
                    <Button x:Name="WebEngineBtn" Content="🌐 Web" FontSize="11" Padding="8,3.5" Margin="0,0,4,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="WebEngineBtn_Click"
                            ToolTip="Dahili WebView2 Oynatıcıya Geç" />

                    <!-- VLC Engine Button -->
                    <Button x:Name="VlcEngineBtn" Content="🎬 VLC" FontSize="11" Padding="8,3.5" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="VlcEngineBtn_Click"
                            ToolTip="Pencere İçi Gömülü VLC Oynatıcıya Geç (Düşük Gecikme &amp; Düşük Kaynak)" />

                    <!-- Quality Selector Button with ContextMenu -->
                    <Button x:Name="QualityButton" Style="{StaticResource SecondaryButton}"
                            Padding="10,4.5"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Click="QualityButton_Click"
                            ToolTip="Yayın Çözünürlüğü ve Kalitesini Değiştir">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙ " Foreground="#53FC18" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="QualityDisplayText" Text="Kaynak (En İyi)"
                                       FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="▾" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="QualityContextMenu">
                                <MenuItem Header="Kaynak (En İyi)" Tag="best" Click="QualityMenuItem_Click" />
                                <MenuItem Header="1080p 60 FPS" Tag="1080p60" Click="QualityMenuItem_Click" />
                                <MenuItem Header="720p 60 FPS" Tag="720p60" Click="QualityMenuItem_Click" />
                                <MenuItem Header="720p (Normal)" Tag="720p" Click="QualityMenuItem_Click" />
                                <MenuItem Header="480p" Tag="480p" Click="QualityMenuItem_Click" />
                                <MenuItem Header="360p (Tasarruf)" Tag="360p" Click="QualityMenuItem_Click" />
                                <MenuItem Header="160p (Düşük)" Tag="160p" Click="QualityMenuItem_Click" />
                                <MenuItem Header="En Düşük (worst)" Tag="worst" Click="QualityMenuItem_Click" />
                                <MenuItem Header="Sadece Ses" Tag="audio_only" Click="QualityMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <TextBlock x:Name="StatusSubText" Text="• F11 veya Çift Tıklama ile Tam Ekran" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="TopMostCheck" Content="📌 Üstte Tut (PiP)" FontSize="11.5" Margin="0,0,12,0"
                              VerticalAlignment="Center" Checked="TopMostCheck_Changed" Unchecked="TopMostCheck_Changed" />
                    <Button x:Name="MuteBtn" Content="🔊 Sesi Kapat" Style="{StaticResource SecondaryButton}"
                            FontSize="11" Padding="9,4" Margin="0,0,6,0" Click="MuteBtn_Click" />
                    <Button Content="⟳ Yenile" Style="{StaticResource SecondaryButton}"
                            FontSize="11" Padding="9,4" Margin="0,0,6,0" Click="ReloadBtn_Click" />
                    <Button Content="⛶ Tam Ekran (F11)" Style="{StaticResource PrimaryButton}"
                            FontSize="11" Padding="10,4" Click="FullScreenBtn_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dual Player Surface (WebView2 + WindowsFormsHost VLC) -->
        <Grid Grid.Row="1" Background="#04090F">
            <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#04090F" />

            <wfi:WindowsFormsHost x:Name="VlcHost"
                                  Background="#04090F"
                                  Visibility="Collapsed">
                <wf:Panel x:Name="VlcPanel" Dock="Fill" DoubleClick="VlcPanel_DoubleClick" />
            </wfi:WindowsFormsHost>
        </Grid>
    </Grid>
</Window>
